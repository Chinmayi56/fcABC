# Farm-Craft Backend Environment Configuration

APP_NAME=Farm-Craft API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=farmcraft_db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://framcraft-aadmin-ten.vercel.app,https://framcraft-abc.vercel.app

# JWT
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Customer demo OTP
OTP_EXPIRE_MINUTES=5
OTP_DEMO_CODE=1234
OTP_MAX_ATTEMPTS=5

# Demo Admin
DEMO_ADMIN_EMAIL=admin@farmcraft.com
DEMO_ADMIN_PASSWORD=admin123
